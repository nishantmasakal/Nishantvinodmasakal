// Single-file app: serves an HTML page (inline CSS/JS) with TicTacToe, Chess, online rooms and chat.
// Developer credit displayed at the top: "Developed by Nishant Vinod Masakal"
// Usage:
// 1) Save as server.js
// 2) npm init -y
// 3) npm install express socket.io
// 4) node server.js
// 5) Open http://localhost:3000
const express = require('express');
const http = require('http');
const { Server } = require('socket.io');

const app = express();
const server = http.createServer(app);
const io = new Server(server);

const PORT = process.env.PORT || 3000;

// In-memory room storage (simple)
const rooms = {};

// Serve the single-page app
app.get('/', (req, res) => {
  res.setHeader('Content-Type', 'text/html; charset=utf-8');
  res.send(`<!doctype html>

<!-- libs -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/1.0.0/chess.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chessboard-js/1.0.0/chessboard-1.0.0.min.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
/* Client-side logic: TTT, Chess, Chat, Online sync via socket.io */
(function(){
  const socket = (window.io ? io() : null);

  // Elements
  const gameSelect = document.getElementById('gameSelect');
  const playMode = document.getElementById('playMode');
  const tttArea = document.getElementById('tttArea');
  const chessArea = document.getElementById('chessArea');
  const newGameBtn = document.getElementById('newGameBtn');
  const roomInput = document.getElementById('roomInput');
  const createBtn = document.getElementById('createBtn');
  const joinBtn = document.getElementById('joinBtn');
  const roomStatus = document.getElementById('roomStatus');

  const chatMessages = document.getElementById('chatMessages');
  const chatInput = document.getElementById('chatInput');
  const sendChatBtn = document.getElementById('sendChatBtn');

  // TTT elements
  const tttBoardEl = document.getElementById('tttBoard');
  const tttStatus = document.getElementById('tttStatus');
  const tttReset = document.getElementById('tttReset');

  // Chess elements
  const chessStatus = document.getElementById('chessStatus');

  let myRoom = null;
  let myPlayerIndex = null;
  let myName = null;

  // TTT state
  let tttState = Array(9).fill(null);
  let tttTurn = 'X';
  let tttLocked = false;

  // Chess state
  let board = null;
  let game = null;
  let onlineMyColor = null;

  // UI wiring
  gameSelect.addEventListener('change', updateView);
  playMode.addEventListener('change', updateView);
  newGameBtn.addEventListener('click', startGame);
  createBtn.addEventListener('click', createRoom);
  joinBtn.addEventListener('click', joinRoom);
  sendChatBtn.addEventListener('click', sendChat);
  chatInput.addEventListener('keydown', (e)=>{ if(e.key==='Enter') sendChat(); });

  // --- TTT functions ---
  function renderTTT(){
    tttBoardEl.innerHTML = '';
    for(let i=0;i<9;i++){
      const cell = document.createElement('div');
      cell.className = 'ttt-cell' + (tttLocked ? ' disabled' : '');
      cell.textContent = tttState[i] || '';
      cell.dataset.idx = i;
      cell.addEventListener('click', ()=>onTTTClick(i));
      tttBoardEl.appendChild(cell);
    }
    const winner = checkTTTWinner(tttState);
    if(winner) tttStatus.textContent = (winner==='draw' ? 'Draw' : winner + ' wins!');
    else tttStatus.textContent = 'Turn: ' + tttTurn;
  }

  function onTTTClick(i){
    if(tttState[i] || tttLocked) return;
    if(playMode.value === 'online' && socket){
      if(!myRoom){ alert('Join/create a room first'); return; }
      const mySymbol = myPlayerIndex === 1 ? 'X' : (myPlayerIndex === 2 ? 'O' : null);
      if(!mySymbol){ alert('Waiting for second player'); return; }
      if(tttTurn !== mySymbol){ alert('Not your turn'); return; }
      makeTTTMove(i, mySymbol);
      socket.emit('ttt-move', { room: myRoom, idx: i, symbol: mySymbol });
      return;
    }

    makeTTTMove(i, tttTurn);
    if(playMode.value === 'computer' && !checkTTTWinner(tttState)){
      tttLocked = true;
      setTimeout(()=>tttAIMove(), 220);
    }
  }

  function makeTTTMove(i, symbol){
    if(tttState[i]) return;
    tttState[i] = symbol;
    tttTurn = (symbol==='X' ? 'O' : 'X');
    renderTTT();
  }

  function tttAIMove(){
    const best = minimaxTTT(tttState, tttTurn);
    if(best && best.index !== undefined) makeTTTMove(best.index, tttTurn);
    tttLocked = false;
  }

  tttReset.addEventListener('click', ()=>{
    tttState = Array(9).fill(null);
    tttTurn = 'X';
    tttLocked = false;
    renderTTT();
    if(playMode.value==='online' && socket && myRoom) socket.emit('ttt-reset', { room: myRoom });
  });

  function checkTTTWinner(b){
    const lines = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
    for(const [a,b1,c] of lines){
      if(b[a] && b[a]===b[b1] && b[a]===b[c]) return b[a];
    }
    if(b.every(x=>x)) return 'draw';
    return null;
  }

  function minimaxTTT(boardState, player){
    const human='X', ai='O';
    const winner = checkTTTWinner(boardState);
    if(winner === 'X') return { score: -10 };
    if(winner === 'O') return { score: 10 };
    if(winner === 'draw') return { score: 0 };

    const moves = [];
    for(let i=0;i<9;i++){
      if(boardState[i]) continue;
      const newBoard = boardState.slice();
      newBoard[i] = player;
      const result = minimaxTTT(newBoard, player === 'X' ? 'O' : 'X');
      moves.push({ index:i, score: result.score });
    }

    if(player === ai){
      let bestScore = -Infinity, bestMove = null;
      for(const m of moves) if(m.score > bestScore){ bestScore = m.score; bestMove = m; }
      return bestMove || { score:0 };
    } else {
      let bestScore = Infinity, bestMove = null;
      for(const m of moves) if(m.score < bestScore){ bestScore = m.score; bestMove = m; }
      return bestMove || { score:0 };
    }
  }

  // --- Chess functions ---
  function initChess(){
    game = new Chess();
    const cfg = {
      draggable: true,
      position: 'start',
      onDragStart: function(source, piece){
        if(playMode.value === 'online' && socket){
          if(!myRoom || !onlineMyColor) return false;
          if(game.turn() !== onlineMyColor) return false;
          if((onlineMyColor==='w' && piece.search(/^b/)===0) || (onlineMyColor==='b' && piece.search(/^w/)===0)) return false;
        } else {
          if((game.turn()==='w' && piece.search(/^b/)===0) || (game.turn()==='b' && piece.search(/^w/)===0)) return false;
        }
      },
      onDrop: function(source, target){
        const move = game.move({ from: source, to: target, promotion: 'q' });
        if(move === null) return 'snapback';
        board.position(game.fen());
        updateChessStatus();
        if(playMode.value === 'online' && socket && myRoom){
          socket.emit('chess-move', { room: myRoom, fen: game.fen() });
        } else if(playMode.value === 'computer'){
          setTimeout(()=>chessComputerMove(), 350);
        }
      },
      onSnapEnd: function(){ board.position(game.fen()); }
    };
    board = Chessboard('board', cfg);
    updateChessStatus();
  }

  function updateChessStatus(){
    if(game.in_checkmate()){
      chessStatus.textContent = 'Checkmate. ' + (game.turn()==='w' ? 'Black' : 'White') + ' wins.';
    } else if(game.in_draw() || game.in_stalemate() || game.in_threefold_repetition()){
      chessStatus.textContent = 'Draw.';
    } else {
      chessStatus.textContent = (game.turn()==='w' ? 'White' : 'Black') + ' to move' + (game.in_check() ? ' — check!' : '');
    }
  }

  function chessComputerMove(){
    if(game.game_over()) return;
    const moves = game.moves();
    let best = null, bestScore = -Infinity;
    for(const mSan of moves){
      const c = new Chess(game.fen());
      c.move(mSan);
      const s = evaluateMaterial(c);
      if(s > bestScore){ bestScore = s; best = mSan; }
    }
    if(best){
      game.move(best);
      board.position(game.fen());
      updateChessStatus();
    }
  }

  function evaluateMaterial(ch){
    const pieces = { p:1, n:3, b:3, r:5, q:9 };
    let score = 0;
    const boardPart = ch.fen().split(' ')[0];
    for(const chChar of boardPart){
      if(chChar === '/' || chChar === ' ') continue;
      if(chChar >= '1' && chChar <= '8') continue;
      const lower = chChar.toLowerCase();
      const value = pieces[lower] || 0;
      score += (chChar === lower ? -value : value);
    }
    return score;
  }

  document.getElementById('chessReset').addEventListener('click', ()=>{
    if(game) game.reset();
    if(board) board.position('start');
    updateChessStatus();
    if(playMode.value==='online' && socket && myRoom) socket.emit('chess-reset', { room: myRoom });
  });

  // --- Chat functions ---
  function renderChatHistory(messages){
    chatMessages.innerHTML = '';
    if(!messages || messages.length === 0){
      chatMessages.innerHTML = '<div class="chat-empty">No messages yet.</div>';
      return;
    }
    messages.forEach(addChatMessage);
  }
  function addChatMessage(msg){
    const el = document.createElement('div');
    const isMe = msg.user === myName || msg.user === 'You';
    el.className = 'chat-message ' + (isMe ? 'me' : 'other');
    const meta = document.createElement('span');
    meta.className = 'meta';
    meta.textContent = (msg.user || 'Player') + ' • ' + (msg.time || new Date().toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' }));
    const txt = document.createElement('div');
    txt.textContent = msg.text || '';
    el.appendChild(meta);
    el.appendChild(txt);
    chatMessages.appendChild(el);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }
  function sendChat(){
    if(!socket || !myRoom){ alert('Join/create a room before chatting.'); return; }
    const text = chatInput.value.trim();
    if(!text) return;
    const msg = { room: myRoom, user: myName || ('Player ' + (myPlayerIndex||1)), text };
    socket.emit('send-chat-message', msg);
    addChatMessage({ user: 'You', text, time: new Date().toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' }) });
    chatInput.value = '';
  }

  // --- Socket handlers ---
  if(socket){
    socket.on('connect', ()=>{ console.log('connected to server'); });

    socket.on('room-joined', (data)=>{
      myRoom = data.room;
      myPlayerIndex = data.playerIndex;
      myName = 'Player ' + myPlayerIndex;
      onlineMyColor = data.color || null;
      roomStatus.textContent = 'In room ' + myRoom + ' as player ' + myPlayerIndex;
      renderChatHistory(Array.isArray(data.chatHistory) ? data.chatHistory : []);
    });

    socket.on('chat-message', (msg)=>{ addChatMessage(msg); });

    socket.on('ttt-move', ({ idx, symbol })=>{
      if(idx==null || !symbol) return;
      makeTTTMove(idx, symbol);
    });

    socket.on('ttt-reset', ()=>{
      tttState = Array(9).fill(null);
      tttTurn = 'X';
      tttLocked = false;
      renderTTT();
    });

    socket.on('chess-move', ({ fen })=>{
      if(!game) return;
      game.load(fen);
      board.position(game.fen());
      updateChessStatus();
    });

    socket.on('chess-reset', ()=>{
      if(!game) return;
      game.reset();
      board.position('start');
      updateChessStatus();
    });

    socket.on('room-full', (msg)=>{ alert(msg); });

    socket.on('player-left', ()=>{ if(myRoom) roomStatus.textContent = 'In room ' + myRoom + ' — waiting for opponent'; });
  }

  // --- Room utilities ---
  function createRoom(){
    const code = generateRoomCode();
    roomInput.value = code;
    joinRoom();
  }
  function joinRoom(){
    if(!socket){ alert('Server socket not available'); return; }
    const code = roomInput.value.trim();
    if(!code){ alert('Please enter a room code or create one'); return; }
    const gameType = gameSelect.value;
    socket.emit('join-room', { room: code, game: gameType }, (resp)=>{
      if(resp && resp.error){ alert(resp.error); return; }
      // server will emit 'room-joined'
    });
  }
  function generateRoomCode(){
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let out=''; for(let i=0;i<5;i++) out += chars[Math.floor(Math.random()*chars.length)];
    return out;
  }

  // --- View & start ---
  function updateView(){
    if(gameSelect.value === 'ttt'){ tttArea.classList.remove('hidden'); chessArea.classList.add('hidden'); }
    else { tttArea.classList.add('hidden'); chessArea.classList.remove('hidden'); }
  }
  function startGame(){
    tttState = Array(9).fill(null);
    tttTurn = 'X';
    tttLocked = false;
    renderTTT();
    if(board && game){ game.reset(); board.position('start'); updateChessStatus(); } else initChess();
    if(playMode.value === 'online' && socket && myRoom) socket.emit('request-sync', { room: myRoom });
  }

  // init
  renderTTT();
  initChess();
  updateView();
})();
</script>
</body>
</html>`);
});

// Socket.io server logic
io.on('connection', (socket) => {
  // join-room: { room, game } => callback ack
  socket.on('join-room', ({ room, game }, cb) => {
    const normalized = String(room || '').toUpperCase().trim();
    if(!normalized){
      cb && cb({ error: 'Room code required' });
      return;
    }
    const existing = io.sockets.adapter.rooms.get(normalized);
    const count = existing ? existing.size : 0;
    if(count >= 2){
      cb && cb({ error: 'Room full (max 2 players)' });
      socket.emit('room-full', 'Room is full');
      return;
    }

    socket.join(normalized);

    if(!rooms[normalized]){
      rooms[normalized] = { game: game || 'ttt', messages: [], tttState: Array(9).fill(null), chessFen: null };
    }
    rooms[normalized].game = game || rooms[normalized].game;

    const playerIndex = count + 1;
    const payload = {
      room: normalized,
      playerIndex,
      game: rooms[normalized].game,
      chatHistory: rooms[normalized].messages || [],
    };
    if(rooms[normalized].game === 'chess'){
      payload.color = playerIndex === 1 ? 'w' : 'b';
    }

    socket.emit('room-joined', payload);
    socket.to(normalized).emit('player-joined', { playerIndex });
    cb && cb({ ok: true });
  });

  // Chat
  socket.on('send-chat-message', ({ room, user, text }) => {
    const normalized = String(room || '').toUpperCase().trim();
    const cleanText = String(text || '').trim();
    if(!normalized || !cleanText) return;
    if(!rooms[normalized]) rooms[normalized] = { messages: [] };
    const msg = { user: user || 'Player', text: cleanText.slice(0, 200), time: new Date().toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' }) };
    rooms[normalized].messages.push(msg);
    // cap message history
    if(rooms[normalized].messages.length > 200) rooms[normalized].messages = rooms[normalized].messages.slice(-200);
    io.to(normalized).emit('chat-message', msg);
  });

  // TTT
  socket.on('ttt-move', ({ room, idx, symbol }) => {
    const normalized = String(room || '').toUpperCase().trim();
    if(!normalized || idx == null || !symbol) return;
    if(!rooms[normalized]) rooms[normalized] = {};
    // optionally save state (simple)
    if(!rooms[normalized].tttState) rooms[normalized].tttState = Array(9).fill(null);
    rooms[normalized].tttState[idx] = symbol;
    socket.to(normalized).emit('ttt-move', { idx, symbol });
  });

  socket.on('ttt-reset', ({ room }) => {
    const normalized = String(room || '').toUpperCase().trim();
    if(!normalized) return;
    if(rooms[normalized]) rooms[normalized].tttState = Array(9).fill(null);
    socket.to(normalized).emit('ttt-reset', {});
  });

  // Chess
  socket.on('chess-move', ({ room, fen }) => {
    const normalized = String(room || '').toUpperCase().trim();
    if(!normalized || !fen) return;
    if(!rooms[normalized]) rooms[normalized] = {};
    rooms[normalized].chessFen = fen;
    socket.to(normalized).emit('chess-move', { fen });
  });

  socket.on('chess-reset', ({ room }) => {
    const normalized = String(room || '').toUpperCase().trim();
    if(!normalized) return;
    if(rooms[normalized]) rooms[normalized].chessFen = null;
    socket.to(normalized).emit('chess-reset', {});
  });

  // Sync request (upon join or manual)
  socket.on('request-sync', ({ room }) => {
    const normalized = String(room || '').toUpperCase().trim();
    if(!normalized || !rooms[normalized]) return;
    const meta = rooms[normalized];
    if(meta.chessFen) socket.emit('chess-move', { fen: meta.chessFen });
    if(meta.tttState) {
      // broadcast each non-null cell to the requester so they can set state
      meta.tttState.forEach((s, idx) => { if(s) socket.emit('ttt-move', { idx, symbol: s }); });
    }
    // and send chat history (already sent on join)
  });

  // notify peer on disconnect
  socket.on('disconnecting', () => {
    for(const room of socket.rooms){
      if(room === socket.id) continue;
      socket.to(room).emit('player-left', {});
    }
  });
});

server.listen(PORT, ()=>console.log('Server running on http://localhost:' + PORT));
